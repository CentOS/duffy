{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:nonOfficeHours",
    ":separateMultipleMajorReleases",
    ":automergeMinor",
    ":gitSignOff"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "group:allNonMajor",
      "schedule:daily"
    ],
    "commitMessageAction": "Update"
  },
  "automergeStrategy": "rebase",
  "rangeStrategy": "widen",
  "minimumReleaseAge": "3 days",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchCategories": [
        "python"
      ],
      "addLabels": [
        "python"
      ]
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true,
      "groupName": "dev dependencies"
    }
  ]
}
